---
import { pillars } from '../data/cv';
---

<section id="about">
  <div class="container">
    <p class="section-label">// profile</p>
    <h2 class="section-title">Where business meets data</h2>
    <div class="grid">
      {
        pillars.map((p, i) => (
          <article class="panel reveal">
            <span class="idx">0{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }
  .idx {
    font-family: var(--font-mono);
    color: var(--accent-3);
    font-size: 0.85rem;
  }
  h3 {
    font-size: 1.35rem;
    margin: 8px 0 10px;
  }
  p {
    color: var(--fg-muted);
    margin: 0;
  }
</style>
